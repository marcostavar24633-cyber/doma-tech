[Unit]
Description=Check DOMA TECH backup health

[Service]
Type=oneshot
User=doma-tech
Group=doma-tech
WorkingDirectory=/opt/doma-tech
EnvironmentFile=-/opt/doma-tech/.env
ExecStart=/usr/bin/npm run db:backup-health
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/doma-tech/data /opt/doma-tech/backups
