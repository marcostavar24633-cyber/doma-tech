[Unit]
Description=DOMA TECH SQLite backup cycle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=doma-tech
Group=doma-tech
WorkingDirectory=/opt/doma-tech
EnvironmentFile=-/opt/doma-tech/.env
ExecStart=/usr/bin/npm run db:backup-cycle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/doma-tech/data /opt/doma-tech/backups
