PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
BACKUP_RETENTION_COUNT=7
# Optional offsite copy via an installed and configured rclone remote
# OFFSITE_RCLONE_REMOTE=encrypted-remote:doma-tech
# RCLONE_BIN=rclone
# Set true to fail the cycle if offsite storage is not configured
OFFSITE_REQUIRED=false

# Optional backup alerts: configure both Telegram values to enable Telegram delivery
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Or use an HTTPS webhook receiver
# BACKUP_ALERT_WEBHOOK=
