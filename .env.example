PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
# Keep public request intake disabled until legal text, consent and operations are ready
ORDER_INTAKE_ENABLED=false
BACKUP_RETENTION_COUNT=7
# Optional offsite copy via an installed and configured rclone remote
# OFFSITE_RCLONE_REMOTE=encrypted-remote:doma-tech
# RCLONE_BIN=rclone
# Set true to fail the cycle if offsite storage is not configured
OFFSITE_REQUIRED=false

# Optional backup alerts: configure both Telegram values to enable Telegram delivery
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Or use an HTTPS webhook receiver
# BACKUP_ALERT_WEBHOOK=

# Optional order notifications (separate from backup alerts)
# Telegram sends order number and timestamp only; it does not send customer contact details
# ORDER_TELEGRAM_BOT_TOKEN=
# ORDER_TELEGRAM_CHAT_ID=
# Optional HTTPS webhook receiving order ID and timestamp only
# ORDER_ALERT_WEBHOOK=

# Required together with ORDER_INTAKE_ENABLED=true to expose checkout.
# Use the public HTTPS URL of your reviewed privacy policy and a version label for the consent text.
# PRIVACY_POLICY_URL=https://your-real-domain.example/privacy
# ORDER_CONSENT_VERSION=2026-11-15-v1

# Enable order intake only after the privacy notice is published and verified.
# The checkout form remains hidden unless both values are configured.
# PRIVACY_POLICY_URL=https://your-domain.example/privacy
# ORDER_CONSENT_VERSION=2026-11-15-v1
